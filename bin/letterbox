#!/usr/bin/env bash
# letterbox — dependency-free helper for Agent Letterbox.
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
  SCRIPT_LINK_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_LINK_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
VERSION_FILE="$SCRIPT_DIR/../VERSION"
DEFAULT_DIR_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/agent-letterbox/default-dir"
if [[ -n "${LETTERBOX_DIR:-}" ]]; then
  BOX="$LETTERBOX_DIR"
elif [[ -f "$DEFAULT_DIR_FILE" ]]; then
  BOX="$(<"$DEFAULT_DIR_FILE")"
else
  BOX="$PWD/.letterbox"
fi
ME="${LETTERBOX_AGENT:-}"
SESSION="${LETTERBOX_SESSION:-}"
REPLY_FILE=""
REPLY_ALREADY=false
LIFECYCLE_LOCK=""

die() { printf 'letterbox: %s\n' "$*" >&2; exit 1; }
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
id_now() { date -u +%Y-%m-%dT%H%M%S; }
random_suffix() { od -An -N4 -tx4 /dev/urandom | tr -d '[:space:]'; }
need_me() { [[ "$ME" =~ ^[a-z][a-z0-9-]*$ ]] || die 'set LETTERBOX_AGENT to a lowercase agent name'; }
need_agent() { [[ "$1" =~ ^[a-z][a-z0-9-]*$ ]] || die "invalid agent name: $1"; }
inbox_path() { printf '%s/%s/inbox' "$BOX" "$1"; }
processed_path() { printf '%s/%s/processed' "$BOX" "$1"; }
canonical_dir() { (cd "$1" && pwd -P); }
# Outbox is bridge correspondence-in-flight. Never inbound mail.
refuse_outbox() {
  if [[ "$(basename "$(dirname "$1")")" == "outbox" ]]; then
    die "outbox is not inbound mail"
  fi
}

frontmatter_value() {
  awk -v wanted="$2" '
    {
      line = $0
      sub(/\r$/, "", line)
    }
    NR == 1 && line == "---" { in_frontmatter = 1; next }
    in_frontmatter && line == "---" { exit }
    in_frontmatter {
      key = line; sub(/:.*/, "", key)
      if (key == wanted) {
        value = line; sub(/^[^:]*:[[:space:]]*/, "", value)
        print value; exit
      }
    }
  ' "$1"
}

message_body() {
  # Body after second ---; command-sub consumers strip trailing newlines.
  awk '
    {
      line = $0
      sub(/\r$/, "", line)
    }
    line == "---" { seen++; next }
    seen >= 2 { print }
  ' "$1"
}

# --- v0.3 core helpers (public-safe) ---
# v0.2 exact doorbell bytes. v0.3 appends " · <8hex>" after this tail.
# Public products use "letterbox" branding; private bus may say "bus".
V02_DOORBELL_PREFIX="📬 letterbox doorbell: unacked "
V02_DOORBELL_TAIL=" — please check"
BUS_CHECK_STALE_DAYS="${LETTERBOX_CHECK_STALE_DAYS:-14}"


bounded_cmd() { # $1=seconds, rest=argv; 124 on timeout, 127 on missing (needs python3)
  local secs="$1"; shift
  command -v python3 >/dev/null 2>&1 || return 124
  python3 -c '
import os, signal, subprocess, sys
try:
    p = subprocess.Popen(sys.argv[2:], start_new_session=True)
except FileNotFoundError:
    sys.exit(127)
try:
    sys.exit(p.wait(timeout=float(sys.argv[1])))
except subprocess.TimeoutExpired:
    try:
        os.killpg(p.pid, signal.SIGKILL)
    except Exception:
        p.kill()
    p.wait()
    sys.exit(124)
' "$secs" "$@"
}

doorbell_token_for_id() { # random 8-hex tail, else sha256(id)[:8]
  local id="$1" tail
  tail="${id##*-}"
  if [[ "$tail" =~ ^[0-9a-f]{8}$ ]]; then
    printf '%s\n' "$tail"
    return 0
  fi
  printf '%s' "$id" | shasum -a 256 2>/dev/null | awk '{print substr($1,1,8)}' \
    || printf '%s' "$id" | sha256sum 2>/dev/null | awk '{print substr($1,1,8)}' \
    || printf '%s' "$id" | openssl dgst -sha256 2>/dev/null | awk '{print substr($NF,1,8)}'
}

display_id() {
  local id="$1" ts="unknown"
  if [[ "$id" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{6}) ]]; then
    ts="${BASH_REMATCH[1]}"
  fi
  printf '%s · %s' "$ts" "$(doorbell_token_for_id "$id")"
}

safe_id_out() {
  case "$1" in
    *" · "*) printf '%s' "$1";;
    *) display_id "$1";;
  esac
}

# User-facing confirmation/error label: display_id from frontmatter id, never basename/slug.
confirm_label() {
  local f="$1" id
  id="$(frontmatter_value "$f" id 2>/dev/null || true)"
  if [[ -z "$id" ]]; then
    id="${f##*/}"
    id="${id%.md}"
  fi
  display_id "$id"
}

# Body before lock: a hanging stdin must not pin the letter.
read_reply_body_or_die() {
  # Fail-fast: never wait on a TTY and never take a lifecycle lock first.
  if [[ -t 0 ]]; then
    die "usage: pipe the reply body via stdin (letterbox reply <id> <ack|nack|result> <slug> [--now])"
  fi
  local body
  if ! IFS= read -r -d '' body < <(cat; printf '\0'); then die 'cannot read reply body'; fi
  body="$(printf '%s' "$body")"
  [[ -n "$body" ]] || die 'empty reply body'
  REPLY_BODY="$body"
}

format_doorbell_line() { # $1=to $2=type $3=id — never slug/body/full-id
  local to="$1" type="$2" id="$3" root
  root="${LETTERBOX_DIR:-$BOX}"
  printf '%s%s in %s/%s/inbox/%s · %s\n' \
    "$V02_DOORBELL_PREFIX" "$type" "$root" "$to" "$V02_DOORBELL_TAIL" "$(doorbell_token_for_id "$id")"
}

parse_doorbell_line() { # $1=line → v02 | v03 <token> | reject
  local line="$1" rest tok
  case "$line" in
    "$V02_DOORBELL_PREFIX"*"$V02_DOORBELL_TAIL"*) ;;
    *) echo reject; return 1;;
  esac
  rest="${line#*"$V02_DOORBELL_TAIL"}"
  if [[ -z "$rest" ]]; then
    echo v02
    return 0
  fi
  tok="${rest# · }"
  if [[ "$rest" == " · $tok" && "$tok" =~ ^[0-9a-f]{8}$ ]]; then
    echo "v03 $tok"
    return 0
  fi
  echo reject
  return 1
}

message_arg_is_path() { [[ -f "$1" ]]; }



parse_acked_at_epoch() {
  local stamp="$1" raw
  [[ -f "$stamp" ]] || { echo 0; return; }
  raw="$(awk -F': ' '/^acked_at:/{print $2; exit}' "$stamp" 2>/dev/null || true)"
  [[ -n "$raw" ]] || { echo 0; return; }
  # macOS date / GNU date
  if date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$raw" +%s 2>/dev/null; then return; fi
  date -u -d "$raw" +%s 2>/dev/null || echo 0
}

parse_progress_at_epoch() {
  local stamp="$1" raw
  [[ -f "$stamp" ]] || { echo 0; return; }
  raw="$(awk -F': ' '/^progress_at:/{print $2; exit}' "$stamp" 2>/dev/null || true)"
  [[ -n "$raw" ]] || { echo 0; return; }
  if date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$raw" +%s 2>/dev/null; then return; fi
  date -u -d "$raw" +%s 2>/dev/null || echo 0
}



age_human() {
  local secs="$1" d h m
  if (( secs < 60 )); then printf '%ss' "$secs"; return; fi
  if (( secs < 3600 )); then printf '%sm' "$((secs/60))"; return; fi
  if (( secs < 86400 )); then printf '%sh' "$((secs/3600))"; return; fi
  printf '%sd' "$((secs/86400))"
}


zellij_registry_path() { printf '%s' "${LETTERBOX_ZELLIJ_REGISTRY:-$BOX/zellij-agents.tsv}"; }
zellij_patterns_path() { printf '%s' "${LETTERBOX_ZELLIJ_PATTERNS:-$BOX/zellij-patterns.tsv}"; }

zellij_bin() { printf '%s' "${ZELLIJ_BIN_PATH:-zellij}"; }

need_zellij_cli() {
  command -v "$(zellij_bin)" >/dev/null 2>&1 || die 'zellij is unavailable (install Zellij 0.44+ and ensure it is on PATH)'
}

# Normalize pane id: "1" and "terminal_1" both accepted.
zellij_pane_token() {
  local id="$1"
  if [[ "$id" =~ ^[0-9]+$ ]]; then
    printf 'terminal_%s' "$id"
  else
    printf '%s' "$id"
  fi
}

zellij_pane_live() {
  local pane_id="$1" session="${2:-}"
  need_zellij_cli
  local token list
  token="$(zellij_pane_token "$pane_id")"
  if [[ -n "$session" ]]; then
    list="$("$(zellij_bin)" -s "$session" action list-panes 2>/dev/null || true)"
  else
    list="$("$(zellij_bin)" action list-panes 2>/dev/null || true)"
  fi
  # list-panes columns: PANE_ID TYPE TITLE — match first column only.
  printf '%s\n' "$list" | awk -v t="$token" -v p="$pane_id" '
    $1 == t || $1 == p || $1 == ("terminal_" p) { found = 1 }
    END { exit !found }
  '
}

cmd_zellij_register() {
  local agent="${1:?usage: letterbox zellij register <agent>}" registry pane session tmp owner
  need_agent "$agent"
  need_zellij_cli
  [[ -n "${ZELLIJ:-}" || -n "${ZELLIJ_SESSION_NAME:-}" ]] || die 'run registration from inside a Zellij session (ZELLIJ/ZELLIJ_SESSION_NAME unset)'
  pane="${ZELLIJ_PANE_ID:-}"
  session="${ZELLIJ_SESSION_NAME:-}"
  [[ -n "$pane" ]] || die 'ZELLIJ_PANE_ID is missing; run inside a Zellij pane'
  [[ -n "$session" ]] || die 'ZELLIJ_SESSION_NAME is missing; run inside a Zellij session'
  zellij_pane_live "$pane" "$session" || die "zellij pane is not live: $pane (session $session)"
  mkdir -p "$BOX/$agent/inbox" "$BOX/$agent/processed" "$BOX/locks"
  registry="$(zellij_registry_path)"
  mkdir -p "$(dirname "$registry")"
  if [[ -f "$registry" ]]; then
    owner="$(awk -F '\t' -v pane="$pane" -v sess="$session" '$2 == pane && $3 == sess { print $1; exit }' "$registry")"
    [[ -z "$owner" || "$owner" == "$agent" ]] || die "pane $pane in session $session is already registered to $owner"
  fi
  tmp="$(mktemp "$(dirname "$registry")/.zellij-agents.tmp.XXXXXX")"
  [[ -f "$registry" ]] && awk -F '\t' -v agent="$agent" '$1 != agent { print }' "$registry" > "$tmp"
  # agent<TAB>pane_id<TAB>session_name<TAB>registered_at
  printf '%s\t%s\t%s\t%s\n' "$agent" "$pane" "$session" "$(now)" >> "$tmp"
  mv "$tmp" "$registry"
  printf 'registered: %s → pane %s (session %s)\n' "$agent" "$pane" "$session"
}

cmd_zellij_status() {
  local registry="$(zellij_registry_path)"
  [[ -f "$registry" ]] || { printf 'no zellij registrations: %s\n' "$registry"; return; }
  printf 'agent\tpane_id\tsession_name\tregistered_at\n'
  cat "$registry"
}

cmd_zellij_unregister() {
  local agent="${1:?usage: letterbox zellij unregister <agent>}" registry tmp
  need_agent "$agent"
  registry="$(zellij_registry_path)"
  [[ -f "$registry" ]] || { printf 'no zellij registration for %s\n' "$agent"; return; }
  tmp="$(mktemp "$(dirname "$registry")/.zellij-agents.tmp.XXXXXX")"
  awk -F '\t' -v agent="$agent" '$1 != agent { print }' "$registry" > "$tmp"
  mv "$tmp" "$registry"
  printf 'unregistered: %s\n' "$agent"
}

cmd_zellij_setup() {
  local agents='' setup_dir="$HOME/.agent-letterbox" submit=false
  local skill_source="$SCRIPT_DIR/../skills/agent-letterbox"
  local skills_dir="${LETTERBOX_SKILLS_DIR:-$HOME/.agents/skills}" skill_target
  local launcher_dir="${LETTERBOX_BIN_DIR:-$HOME/.local/bin}" launcher_target
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agents) agents="${2:?missing comma-separated agent list}"; shift;;
      --dir) setup_dir="${2:?missing directory}"; shift;;
      --submit|--automatic-doorbells) submit=true;;
      *) die "usage: letterbox zellij setup --agents planner,reviewer,builder,researcher [--dir <path>] [--automatic-doorbells]";;
    esac
    shift
  done
  [[ -n "$agents" ]] || die 'zellij setup requires --agents'
  need_zellij_cli
  [[ -f "$skill_source/SKILL.md" ]] || die "bundled skill missing: $skill_source"
  local agent
  IFS=',' read -r -a agent_list <<< "$agents"
  for agent in "${agent_list[@]}"; do need_agent "$agent"; done

  BOX="$setup_dir"
  mkdir -p "$BOX" "$BOX/locks" "$(dirname "$DEFAULT_DIR_FILE")" "$launcher_dir"
  cmd_init "${agent_list[@]}" >/dev/null
  printf '%s\n' "$BOX" > "$DEFAULT_DIR_FILE"
  : > "$BOX/zellij-agents.tsv"
  if [[ ! -f "$BOX/zellij-patterns.tsv" ]]; then
    cat > "$BOX/zellij-patterns.tsv" <<'PAT'
# Optional static fallback: agent<TAB>pane_id<TAB>session_name
# Prefer live self-registration: letterbox zellij run <agent> -- <command>
PAT
  fi
  mkdir -p "$skills_dir"
  skill_target="$skills_dir/agent-letterbox"
  launcher_target="$launcher_dir/letterbox"
  if [[ -e "$launcher_target" || -L "$launcher_target" ]]; then
    if [[ -L "$launcher_target" && "$(readlink "$launcher_target")" == "$SCRIPT_DIR/letterbox" ]]; then
      :
    else
      die "letterbox launcher already exists at $launcher_target; move it or set LETTERBOX_BIN_DIR"
    fi
  else
    ln -s "$SCRIPT_DIR/letterbox" "$launcher_target"
  fi
  if [[ -e "$skill_target" || -L "$skill_target" ]]; then
    if [[ -L "$skill_target" && "$(readlink "$skill_target")" == "$skill_source" ]]; then
      :
    else
      die "agent-letterbox skill already exists at $skill_target; move it or set LETTERBOX_SKILLS_DIR"
    fi
  else
    ln -s "$skill_source" "$skill_target"
  fi
  cat > "$BOX/env.sh" <<EOF
# Generated by: letterbox zellij setup
export LETTERBOX_DIR='$BOX'
export LETTERBOX_DOORBELL='$SCRIPT_DIR/../adapters/zellij.sh'
export LETTERBOX_ZELLIJ_REGISTRY='$BOX/zellij-agents.tsv'
export LETTERBOX_ZELLIJ_PATTERNS='$BOX/zellij-patterns.tsv'
export AGENT_LETTERBOX_SKILL='$skill_target'
EOF
  [[ "$submit" == true ]] && printf 'export LETTERBOX_ZELLIJ_SUBMIT=1\n' >> "$BOX/env.sh"
  cat > "$BOX/AGENT-LETTERBOX.md" <<'EOF'
# Agent Letterbox startup rule (Zellij)

The shared Agent Letterbox skill is installed at `~/.agents/skills/agent-letterbox`
(or the configured `LETTERBOX_SKILLS_DIR`). Ensure your agent runtime loads global Agent Skills.

You control your own Zellij layout. Launch each agent inside the pane you choose:

```bash
source ~/.agent-letterbox/env.sh
letterbox zellij run <your-agent-id> -- <agent-command>
```

That registers the current Zellij pane id and session name for live doorbells, then starts the agent.

At resume, if the pane id changed:

```bash
letterbox zellij register <your-agent-id>
letterbox check
```

For actionable letters, use `letterbox reply` with body text piped on stdin.
Use `--now` on a reply only when the original letter priority is `now`.
EOF
  printf 'zellij team ready: %s\n' "$BOX"
  printf 'Letterbox launcher linked: %s\n' "$launcher_target"
  printf 'Agent Letterbox skill linked: %s\n' "$skill_target"
  printf 'Source the environment:\n  source %s/env.sh\n' "$BOX"
  printf 'In each agent pane, launch with:\n'
  printf '  letterbox zellij run <agent-id> -- <agent-command>\n'
  [[ "$submit" == true ]] || printf 'Automatic input is off. Re-run with --automatic-doorbells to enable it.\n'
}

cmd_zellij_run() {
  local agent="${1:?usage: letterbox zellij run <agent> -- <command...>}"; shift
  need_agent "$agent"
  [[ "${1:-}" == -- ]] || die 'zellij run requires -- before the agent command'
  shift
  [[ $# -gt 0 ]] || die 'zellij run requires an agent command'
  [[ -f "$BOX/env.sh" ]] && # shellcheck disable=SC1090
    source "$BOX/env.sh"
  BOX="${LETTERBOX_DIR:-$BOX}"
  export LETTERBOX_DIR="$BOX" LETTERBOX_AGENT="$agent"
  cmd_zellij_register "$agent"
  exec "$@"
}

cmd_zellij() {
  case "${1:-}" in
    setup) shift; cmd_zellij_setup "$@";;
    run) shift; cmd_zellij_run "$@";;
    register) shift; cmd_zellij_register "$@";;
    unregister) shift; cmd_zellij_unregister "$@";;
    status) shift; cmd_zellij_status "$@";;
    *) die 'usage: letterbox zellij {setup|run|register|unregister|status} ...';;
  esac
}

cmd_version() {
  [[ -f "$VERSION_FILE" ]] || die "version file not found: $VERSION_FILE"
  printf 'letterbox %s\n' "$(<"$VERSION_FILE")"
}

cmd_init() {
  [[ $# -gt 0 ]] || die 'usage: letterbox init <agent> [agent...]'
  mkdir -p "$BOX/locks"
  local agent
  for agent in "$@"; do
    need_agent "$agent"
    mkdir -p "$BOX/$agent/inbox" "$BOX/$agent/processed"
  done
  printf 'initialized letterbox: %s\n' "$BOX"
}

ring_doorbell() {
  local to="$1" type="$2" slug="$3" id="${4:-}" token="" rc=0
  [[ -n "${LETTERBOX_DOORBELL:-}" ]] || return 0
  [[ -x "$LETTERBOX_DOORBELL" ]] || die "doorbell is not executable: $LETTERBOX_DOORBELL"
  [[ -n "$id" ]] && token="$(doorbell_token_for_id "$id")"
  # Best-effort: the letter is already durable. Bound the adapter run so an
  # unresponsive ring path can never hang a sender (bound needs python3).
  if command -v python3 >/dev/null 2>&1; then
    bounded_cmd "${LETTERBOX_DOORBELL_TIMEOUT:-5}" "$LETTERBOX_DOORBELL" "$to" "$type" "$slug" "$token" || rc=$?
  else
    "$LETTERBOX_DOORBELL" "$to" "$type" "$slug" "$token" || rc=$?
  fi
  if (( rc == 124 )); then
    printf 'letterbox: doorbell no_live_surface adapter_timeout timeout=%ss for %s\n' "${LETTERBOX_DOORBELL_TIMEOUT:-5}" "$to" >&2
  elif (( rc != 0 )); then
    printf 'letterbox: doorbell adapter exited %s for %s (letter is durable)\n' "$rc" "$to" >&2
  fi
  return 0
}


publish_message() { # to type slug priority requires_ack re deadline body [thread]
  local to="$1" type="$2" slug="$3" priority="$4" requires_ack="$5" re="$6" deadline="$7" body="$8"
  local thread="${9:-}"
  local id="$(id_now)-$ME-$type-$slug-$(random_suffix)"
  local inbox; inbox="$(inbox_path "$to")"
  local final="$inbox/$id.md" tmp
  tmp="$(mktemp "$inbox/.${id}.tmp.XXXXXX")" || die 'cannot create temporary message'
  {
    printf '%s\n' '---'
    printf 'id: %s\nfrom: %s\nto: %s\ntype: %s\nre: %s\n' "$id" "$ME" "$to" "$type" "$re"
    [[ -n "$thread" ]] && printf 'thread: %s\n' "$thread"
    printf 'priority: %s\nrequires_ack: %s\ndeadline: %s\n' "$priority" "$requires_ack" "$deadline"
    [[ -n "$SESSION" ]] && printf 'session: %s\n' "$SESSION"
    printf '%s\n%s\n' '---' "$body"
  } > "$tmp"
  if ! ln "$tmp" "$final"; then rm -f "$tmp"; die "message ID collision: $final"; fi
  rm "$tmp"
  printf '%s\n' "$final"
}

reply_file_for() { # parent_id type agent
  printf '%s--%s--%s.md\n' "$1" "$3" "$2"
}

publish_derived_reply() { # parent type body priority
  local parent="$1" type="$2" body="$3" prio="$4"
  local parent_id parent_from thread reply_id reply_file tmp existing_body existing
  parent_id="$(frontmatter_value "$parent" id)"
  parent_from="$(frontmatter_value "$parent" from)"
  thread="$(frontmatter_value "$parent" thread)"
  [[ -n "$thread" ]] || thread="$parent_id"
  [[ -n "$parent_id" && -n "$parent_from" ]] || die "message has invalid frontmatter: $(confirm_label "$parent")"
  [[ -d "$(inbox_path "$parent_from")" ]] || die "original sender has no inbox: $parent_from"
  reply_id="${parent_id}--${ME}--${type}"
  reply_file="$(inbox_path "$parent_from")/$(reply_file_for "$parent_id" "$type" "$ME")"
  if [[ -f "$reply_file" || -f "$(processed_path "$parent_from")/$(basename "$reply_file")" ]]; then
    existing="$reply_file"
    [[ -f "$existing" ]] || existing="$(processed_path "$parent_from")/$(basename "$reply_file")"
    existing_body="$(message_body "$existing")"
    [[ "$existing_body" == "$body" ]] || die "reply collision has different body: $(confirm_label "$existing")"
    REPLY_FILE="$existing"
    REPLY_ALREADY=true
    return 0
  fi
  tmp="$(mktemp "$(inbox_path "$parent_from")/.${reply_id}.tmp.XXXXXX")" || die 'cannot create temporary reply'
  {
    printf '%s\n' '---'
    printf 'id: %s\nfrom: %s\nto: %s\ntype: %s\nre: %s\nthread: %s\npriority: %s\nrequires_ack: false\ndeadline:\n' \
      "$reply_id" "$ME" "$parent_from" "$type" "$parent_id" "$thread" "$prio"
    [[ -n "$SESSION" ]] && printf 'session: %s\n' "$SESSION"
    printf '%s\n%s\n' '---' "$body"
  } > "$tmp"
  if ! ln "$tmp" "$reply_file"; then
    rm -f "$tmp"
    existing="$reply_file"
    [[ -f "$existing" ]] || existing="$(processed_path "$parent_from")/$(basename "$reply_file")"
    [[ -f "$existing" ]] || die "reply publish failed: $(display_id "$reply_id")"
    existing_body="$(message_body "$existing")"
    [[ "$existing_body" == "$body" ]] || die "reply collision has different body: $(confirm_label "$existing")"
    REPLY_FILE="$existing"
    REPLY_ALREADY=true
    return 0
  fi
  rm "$tmp"
  REPLY_FILE="$reply_file"
  REPLY_ALREADY=false
}

create_ack_stamp() { # letter ack_file
  local letter="$1" ack_file="$2" stamp="$1.ack" tmp
  [[ -f "$letter" ]] || return 0
  [[ -f "$stamp" ]] && return 0
  tmp="$(mktemp "$(dirname "$stamp")/.${stamp##*/}.tmp.XXXXXX")" || die 'cannot create ack stamp'
  printf 'ack_id: %s\nacked_at: %s\nby: %s%s\n' \
    "$(frontmatter_value "$ack_file" id)" "$(now)" "$ME" "${SESSION:+ session=$SESSION}" > "$tmp"
  if ! ln "$tmp" "$stamp" 2>/dev/null; then
    rm -f "$tmp"
    [[ -f "$stamp" ]] && return 0
    die "cannot create ack stamp: $stamp"
  fi
  rm "$tmp"
}

acquire_lifecycle_lock() {
  local letter="$1" lock tries=0 pid created now_ts
  lock="${letter}.lifecycle.lock"
  while ! mkdir "$lock" 2>/dev/null; do
    if [[ -f "$lock/pid" ]]; then
      pid="$(cat "$lock/pid" 2>/dev/null || true)"
      if [[ "$pid" =~ ^[0-9]+$ ]] && ! kill -0 "$pid" 2>/dev/null; then
        rm -f "$lock/pid"
        rmdir "$lock" 2>/dev/null || true
        continue
      fi
    else
      created="$(stat -c %Y "$lock" 2>/dev/null || stat -f %m "$lock" 2>/dev/null || echo 0)"
      [[ "$created" =~ ^[0-9]+$ ]] || created=0
      now_ts="$(date +%s)"
      if (( now_ts - created >= 2 )); then
        rmdir "$lock" 2>/dev/null || true
        continue
      fi
    fi
    tries=$((tries + 1))
    (( tries < 500 )) || die "timed out waiting for lifecycle lock: $(basename "$letter")"
    sleep 0.01
  done
  printf '%s\n' "$$" > "$lock/pid"
  LIFECYCLE_LOCK="$lock"
}

release_lifecycle_lock() {
  [[ -n "${LIFECYCLE_LOCK:-}" ]] || return 0
  rm -f "$LIFECYCLE_LOCK/pid"
  rmdir "$LIFECYCLE_LOCK" 2>/dev/null || true
  LIFECYCLE_LOCK=""
}

cmd_send() {
  need_me
  local to="${1:?usage: letterbox send <to> <type> <slug> [--now] [--ack] [--re <id>] [--thread <id>] [--deadline <UTC>]}"
  local type="${2:?missing type}" slug="${3:?missing slug}"; shift 3
  need_agent "$to"
  [[ -d "$(inbox_path "$to")" ]] || die "unknown recipient: $to (run init first)"
  case "$type" in request|delegate|status|blocker|result|ack|nack|info) ;; *) die "invalid message type: $type";; esac
  case "$type" in ack|nack|result) die 'use letterbox reply for ownership replies';; esac
  slug="$(printf '%s' "$slug" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-')"
  [[ -n "$slug" ]] || die 'slug became empty'
  local priority=next requires_ack=false re='' deadline='' thread=''
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --now) priority=now;; --ack) requires_ack=true;;
      --re) re="${2:?missing reply id}"; shift;;
      --thread) thread="${2:?missing thread id}"; shift;;
      --deadline) deadline="${2:?missing deadline}"; shift;;
      *) die "unknown option: $1";;
    esac
    shift
  done
  [[ "$type" != "delegate" || "$requires_ack" == true ]] || die 'delegate letters require --ack'
  [[ -z "$thread" || "$thread" =~ ^[A-Za-z0-9._:-]+$ ]] || die "bad thread id '$thread'"
  local body
  if ! IFS= read -r -d '' body < <(cat; printf '\0'); then die 'cannot read message body'; fi
  body="$(printf '%s' "$body")"
  [[ -n "$body" ]] || die 'empty message body'
  local final letter_id
  final="$(publish_message "$to" "$type" "$slug" "$priority" "$requires_ack" "$re" "$deadline" "$body" "$thread")"
  letter_id="$(basename "$final" .md)"
  printf 'sent: %s\n' "$final"
  [[ "$priority" == now ]] && ring_doorbell "$to" "$type" "$slug" "$letter_id"
  return 0
}







iso_epoch() { # YYYY-MM-DDTHH:MM:SSZ → epoch (BSD or GNU date)
  local ts="$1"
  date -uj -f '%Y-%m-%dT%H:%M:%SZ' "$ts" +%s 2>/dev/null && return 0
  date -u -d "$ts" +%s 2>/dev/null
}

id_ts_epoch() { # compact id timestamp YYYY-MM-DDTHHMMSS → epoch (BSD or GNU date)
  local ts="$1"
  date -uj -f '%Y-%m-%dT%H%M%S' "$ts" +%s 2>/dev/null && return 0
  date -u -d "${ts:0:4}-${ts:5:2}-${ts:8:2} ${ts:11:2}:${ts:13:2}:${ts:15:2} UTC" +%s 2>/dev/null
}

file_mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || date -u +%s; }

id_ts_epoch() { # compact id timestamp YYYY-MM-DDTHHMMSS → epoch (BSD or GNU date)
  local ts="$1"
  date -uj -f '%Y-%m-%dT%H%M%S' "$ts" +%s 2>/dev/null && return 0
  date -u -d "${ts:0:4}-${ts:5:2}-${ts:8:2} ${ts:11:2}:${ts:13:2}:${ts:15:2} UTC" +%s 2>/dev/null
}

letter_epoch() { # $1=id $2=file-fallback
  local id="$1" file="${2:-}"
  if [[ "$id" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{6}) ]]; then
    id_ts_epoch "${BASH_REMATCH[1]}" && return 0
  fi
  [[ -n "$file" && -f "$file" ]] && { file_mtime "$file"; return 0; }
  date -u +%s
}

stamp_epoch() { # $1=stamp $2=key (acked_at|progress_at)
  local raw
  raw="$(awk -F': ' -v k="$2" '$0 ~ "^"k":"{print $2; exit}' "$1" 2>/dev/null || true)"
  [[ -n "$raw" ]] || return 1
  iso_epoch "$raw"
}

progress_epoch() { stamp_epoch "$1" progress_at; }

# Last activity: max(letter timestamp, ACK stamp, progress_at). STALE means silence.
activity_epoch() { # $1=letter file
  local f="$1" id ep cand
  id="$(frontmatter_value "$f" id)"
  ep="$(letter_epoch "$id" "$f")"
  if [[ -f "$f.ack" ]]; then
    if cand="$(stamp_epoch "$f.ack" acked_at)"; then
      (( cand > ep )) && ep="$cand"
    fi
    if cand="$(progress_epoch "$f.ack")"; then
      (( cand > ep )) && ep="$cand"
    fi
  fi
  printf '%s\n' "$ep"
}

cmd_token() { # glance-dismiss a doorbell token: unhandled / filed / unknown
  local tok="${1:?usage: letterbox token <8hex>}" f id agent folder m
  local -a matches=()
  [[ "$tok" =~ ^[0-9a-f]{8}$ ]] || die "token must be 8 lowercase hex"
  shopt -s nullglob
  for folder in inbox processed; do
    for f in "$BOX"/*/"$folder"/*.md; do
      [[ -f "$f" ]] || continue
      id="$(frontmatter_value "$f" id)"
      [[ "$(doorbell_token_for_id "$id")" == "$tok" ]] || continue
      agent="$(basename "$(dirname "$(dirname "$f")")")"
      matches+=("$(display_id "$id")  $folder/$agent")
    done
  done
  shopt -u nullglob
  if (( ${#matches[@]} == 0 )); then
    echo "unknown-token — no letter; ignore"
    return 0
  fi
  if (( ${#matches[@]} > 1 )); then
    echo "ambiguous-token — no dismiss, no ring"
    for m in "${matches[@]}"; do
      printf '  %s\n' "$m"
    done
    return 1
  fi
  for folder in inbox processed; do
    for f in "$BOX"/*/"$folder"/*.md; do
      [[ -f "$f" ]] || continue
      id="$(frontmatter_value "$f" id)"
      if [[ "$(doorbell_token_for_id "$id")" == "$tok" ]]; then
        if [[ "$folder" == "inbox" ]]; then
          echo "unhandled — check"
        else
          echo "already filed — dismiss bell"
        fi
        return 0
      fi
    done
  done
  echo "unknown-token — no letter; ignore"
}

check_stale_secs() {
  local days="${LETTERBOX_CHECK_STALE_DAYS:-14}"
  printf '%s\n' $((days * 86400))
}



format_age() { # $1=epoch
  local now sec
  now="$(date -u +%s)"
  sec=$((now - $1))
  (( sec < 0 )) && sec=0
  if (( sec < 3600 )); then printf '%sm\n' $((sec / 60))
  elif (( sec < 86400 )); then printf '%sh\n' $((sec / 3600))
  else printf '%sd\n' $((sec / 86400))
  fi
}

letter_ack_state() { # $1=file
  if [[ "$(frontmatter_value "$1" requires_ack)" == "true" ]]; then
    if [[ -f "$1.ack" ]]; then printf '%s' " [ACCEPTED]"
    else printf '%s' " [UNACKED]"
    fi
  fi
}

print_progress_line() { # $1=letter file
  local stamp="$1.ack" note age ep
  [[ -f "$stamp" ]] || return 0
  note="$(awk '/^progress:/{sub(/^progress:[[:space:]]*/, ""); print; exit}' "$stamp" 2>/dev/null || true)"
  [[ -n "$note" ]] || return 0
  if ep="$(progress_epoch "$stamp")"; then
    age="$(format_age "$ep")"
    printf '    progress: %s  (age %s)\n' "$note" "$age"
  else
    printf '    progress: %s\n' "$note"
  fi
}

print_letter_card() { # $1=file $2=stale 0|1 $3=age — never prints the body
  local f="$1" stale="$2" age="$3" extra=""
  extra="$(letter_ack_state "$f")"
  if [[ "$stale" == 1 ]]; then
    extra="${extra}  STALE ${age}"
  fi
  echo
  echo "═══ $(display_id "$(frontmatter_value "$f" id)")${extra}"
  printf '    from: %s  type: %s\n' "$(frontmatter_value "$f" from)" "$(frontmatter_value "$f" type)"
  print_progress_line "$f"
}

check_thread() { # $1=thread-or-re id — read-only fan-out (thread: then re:), never writes
  local want="$1" f agent folder id tid rid typ state
  echo "── thread $(display_id "$want")"
  shopt -s nullglob
  for folder in inbox processed; do
    for f in "$BOX"/*/"$folder"/*.md; do
      [[ -f "$f" ]] || continue
      id="$(frontmatter_value "$f" id)"
      tid="$(frontmatter_value "$f" thread)"
      rid="$(frontmatter_value "$f" re)"
      [[ "$tid" == "$want" || "$rid" == "$want" || "$id" == "$want" ]] || continue
      agent="$(basename "$(dirname "$(dirname "$f")")")"
      typ="$(frontmatter_value "$f" type)"
      state="silent"
      if [[ "$folder" == "processed" ]]; then
        case "$typ" in
          result) state="result";;
          nack) state="nack";;
          *) state="filed";;
        esac
      else
        if [[ -f "$f.ack" ]]; then
          state="acked"
        elif [[ "$(frontmatter_value "$f" requires_ack)" == "true" ]]; then
          state="silent"
        else
          state="open"
        fi
      fi
      printf '  %s  %s  %s  %s\n' "$agent" "$folder" "$state" "$(display_id "$id")"
      print_progress_line "$f"
    done
  done
  shopt -u nullglob
}

cmd_check() {
  local who="" recent=false thread=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --recent) recent=true;;
      --all) ;;
      --thread)
        thread="${2:?usage: letterbox check --thread <id>}"
        shift
        ;;
      --*) die "unknown option: $1 (usage: letterbox check [agent] [--recent|--thread <id>])";;
      *)
        [[ -z "$who" ]] || die "usage: letterbox check [agent] [--recent|--thread <id>]"
        who="$1"
        ;;
    esac
    shift
  done
  if [[ -n "$thread" ]]; then
    check_thread "$thread"
    return 0
  fi
  who="${who:-$ME}"
  [[ -n "$who" ]] || die 'letterbox check <agent> (or set LETTERBOX_AGENT)'
  need_agent "$who"
  local dir; dir="$(inbox_path "$who")"
  [[ -d "$dir" ]] || die "unknown agent: $who"
  local f n id ep now stale_secs live_n=0 stale_n=0 oid
  local -a live_rows=() stale_rows=()
  now="$(date -u +%s)"
  stale_secs="$(check_stale_secs)"
  n=0
  for f in "$dir"/*.md; do
    [[ -e "$f" ]] || break
    n=$((n + 1))
    ep="$(activity_epoch "$f")"
    if (( now - ep > stale_secs )); then
      stale_n=$((stale_n + 1))
      stale_rows+=("$ep|$f|$(format_age "$ep")")
    else
      live_n=$((live_n + 1))
      live_rows+=("$ep|$f|$(format_age "$ep")")
    fi
  done
  local days="${LETTERBOX_CHECK_STALE_DAYS:-14}"
  printf '%s\n' "── $who inbox: $n message(s)  open: $live_n live · $stale_n stale (>${days}d)"
  if (( live_n > 0 )); then
    printf '%s\n' "${live_rows[@]}" | sort -t'|' -k1,1nr | while IFS='|' read -r ep f age; do
      print_letter_card "$f" 0 "$age"
    done
  fi
  if [[ "$recent" == true ]]; then
    echo
    echo "$stale_n stale items hidden; run letterbox check to see all open work"
  elif (( stale_n > 0 )); then
    printf '%s\n' "${stale_rows[@]}" | sort -t'|' -k1,1nr | while IFS='|' read -r ep f age; do
      print_letter_card "$f" 1 "$age"
    done
  fi
  for f in "$dir"/*.md.ack; do
    [[ -e "$f" ]] || break
    if [[ ! -f "${f%.ack}" ]]; then
      oid="${f##*/}"
      oid="${oid%.md.ack}"
      printf 'letterbox: warning: orphan ACK sidecar %s\n' "$(safe_id_out "$oid")" >&2
    fi
  done
  return 0
}

cmd_read() {
  need_me
  local arg="${1:?usage: letterbox read <id|display-id|token>}" msg
  msg="$(resolve_action_ref "$arg" owned-inbox 0)" || die "message not found in your inbox: $(safe_id_out "$arg")"
  cat "$msg"
}


cmd_progress() {
  need_me
  local ref="${1:?usage: letterbox progress <id|display-id|token> <one-line note>}"
  shift
  local note="$*"
  [[ -n "$note" ]] || die "usage: letterbox progress <id|display-id|token> <one-line note>"
  [[ "$note" != *$'\n'* ]] || die "progress note must be one line"
  local msg stamp tmp lid inbox_canon processed_canon
  msg="$(resolve_action_ref "$ref" owned 0)" || die "message not found: $(safe_id_out "$ref")"
  # Canonicalize for macOS /var vs /private/var
  msg="$(cd "$(dirname "$msg")" && pwd -P)/$(basename "$msg")"
  inbox_canon="$(canonical_dir "$(inbox_path "$ME")")"
  processed_canon="$(canonical_dir "$(processed_path "$ME")")"
  case "$msg" in
    "$inbox_canon"/*) ;;
    "$processed_canon"/*) die "cannot progress a filed/terminal letter: $(safe_id_out "$ref")";;
    *) die 'can only progress messages in your own inbox';;
  esac
  stamp="$msg.ack"
  [[ -f "$stamp" ]] || die "progress requires an ACK sidecar; use: letterbox reply <id> ack <slug>"
  tmp="$(mktemp "$(dirname "$stamp")/.${stamp##*/}.tmp.XXXXXX")" || die "cannot write progress"
  grep -v -E '^(progress|progress_at):' "$stamp" > "$tmp"
  printf 'progress: %s\nprogress_at: %s\n' "$note" "$(now)" >> "$tmp"
  mv "$tmp" "$stamp"
  lid="$(frontmatter_value "$msg" id)"
  printf 'progress: %s\n' "$(display_id "$lid")"
}


cmd_nudge() {
  need_me
  local ref="${1:?usage: letterbox nudge <id|display-id|token>}" path folder to typ id
  path="$(resolve_action_ref "$ref" nudge 0)" || die "message not found: $(safe_id_out "$ref")"
  folder="$(basename "$(dirname "$path")")"
  [[ "$folder" != "processed" ]] || die "cannot nudge a filed/terminal letter: $(safe_id_out "$ref")"
  id="$(frontmatter_value "$path" id)"
  to="$(basename "$(dirname "$(dirname "$path")")")"
  typ="$(frontmatter_value "$path" type)"
  ring_doorbell "$to" "$typ" "" "$id"
  printf 'nudged: %s → %s\n' "$(display_id "$id")" "$to"
}


cmd_doorbell_line() {
  local to="${1:?usage: letterbox doorbell-line <to> <type> <id>}"
  local type="${2:?}" id="${3:?}"
  format_doorbell_line "$to" "$type" "$id"
}

cmd_doorbell_parse() {
  local line
  if [[ $# -gt 0 ]]; then line="$*"; else IFS= read -r line || true; fi
  parse_doorbell_line "$line"
}

# Shared action-reference resolver. Prints one owned path or dies.
# scope: owned-inbox | owned | nudge
# allow_path: 0|1 (file may pass 1; read/progress/nudge 0)
resolve_action_ref() {
  local arg="$1" scope="$2" allow_path="${3:-0}" parent f id disp tok
  local -a hits=() dirs=()
  [[ -n "$arg" ]] || return 1
  if [[ "$allow_path" == 1 ]] && message_arg_is_path "$arg"; then
    parent="$(cd "$(dirname "$arg")" && pwd -P)" || return 1
    refuse_outbox "$parent/$(basename "$arg")"
    printf '%s/%s\n' "$parent" "$(basename "$arg")"
    return 0
  fi
  case "$arg" in
    /*|./*|../*|*/*) die "use a letter id, display id, or unique token, not a path";;
  esac
  case "$scope" in
    owned-inbox|own-inbox) dirs=("$(inbox_path "$ME")");;
    owned) dirs=("$(inbox_path "$ME")" "$(processed_path "$ME")");;
    nudge)
      shopt -s nullglob
      dirs=("$BOX"/*/inbox "$BOX"/*/processed)
      shopt -u nullglob
      ;;
    *) die "internal: bad resolve scope $scope";;
  esac
  shopt -s nullglob
  for dir in "${dirs[@]}"; do
    [[ -d "$dir" ]] || continue
    for f in "$dir"/*.md; do
      [[ -f "$f" ]] || continue
      id="$(frontmatter_value "$f" id)"
      disp="$(display_id "$id")"
      tok="$(doorbell_token_for_id "$id")"
      if [[ "$id" == "$arg" || "${f##*/}" == "$arg" || "${f##*/}" == "${arg}.md" || "$disp" == "$arg" ]]; then
        hits+=("$f")
      elif [[ "$arg" =~ ^[0-9a-f]{8}$ && "$tok" == "$arg" ]]; then
        hits+=("$f")
      fi
    done
  done
  shopt -u nullglob
  if (( ${#hits[@]} == 0 )); then
    return 1
  fi
  if (( ${#hits[@]} > 1 )); then
    echo "letterbox: ambiguous reference $(safe_id_out "$arg") — no action (matches ${#hits[@]}); use the full letter id" >&2
    local h
    for h in "${hits[@]}"; do
      printf '  %s\n' "$(display_id "$(frontmatter_value "$h" id)")" >&2
    done
    exit 1
  fi
  printf '%s\n' "${hits[0]}"
}

# Resolve id/path/display_id/token to canonical absolute path under own inbox or processed.
resolve_owned_message() {
  local arg="$1" path parent base
  if path="$(resolve_action_ref "$arg" owned 1)"; then
    parent="$(cd "$(dirname "$path")" && pwd -P)" || die "message not found: $arg"
    base="$(basename "$path")"
    printf '%s/%s\n' "$parent" "$base"
    return 0
  fi
  die "message not found: $arg"
}

resolve_own_inbox_message() {
  local arg="$1" path parent base
  if path="$(resolve_action_ref "$arg" owned-inbox 0)"; then
    parent="$(cd "$(dirname "$path")" && pwd -P)" || die "message not found in inbox: $arg"
    base="$(basename "$path")"
    [[ "$parent" == "$(canonical_dir "$(inbox_path "$ME")")" ]] || die "message is not in your inbox: $arg"
    printf '%s/%s\n' "$parent" "$base"
    return 0
  fi
  die "message not found in inbox: $arg"
}


archive_message() {
  local message="$1"
  mv "$message" "$BOX/$ME/processed/"
  printf 'archived: %s\n' "$(confirm_label "$message")"
}

cmd_reply() {
  need_me
  local message="${1:?usage: letterbox reply <id-or-file> <ack|nack|result> <slug> [--now]}"
  local type="${2:?missing reply type}" slug="${3:?missing reply slug}"; shift 3
  case "$type" in ack|nack|result) ;; *) die 'reply type must be ack, nack, or result';; esac
  local priority=next
  while [[ $# -gt 0 ]]; do
    case "$1" in --now) priority=now;; *) die "unknown option: $1";; esac
    shift
  done
  slug="$(printf '%s' "$slug" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-')"
  [[ -n "$slug" ]] || die 'slug became empty'

  local msg parent_id parent_from expected_reply doorbell_to inbox_canon processed_canon req
  msg="$(resolve_owned_message "$message")"
  inbox_canon="$(canonical_dir "$(inbox_path "$ME")")"
  processed_canon="$(canonical_dir "$(processed_path "$ME")")"
  case "$msg" in
    "$inbox_canon"/*) ;;
    "$processed_canon"/*)
      parent_id="$(frontmatter_value "$msg" id)"
      parent_from="$(frontmatter_value "$msg" from)"
      expected_reply="$(inbox_path "$parent_from")/$(reply_file_for "$parent_id" "$type" "$ME")"
      if [[ -f "$expected_reply" || -f "$(processed_path "$parent_from")/$(basename "$expected_reply")" ]]; then
        printf 'already closed: %s (your %s reply is published)\n' "$(confirm_label "$msg")" "$type"
        return 0
      fi
      die "already closed without your $type reply: $(confirm_label "$msg") — use letterbox check; do not letterbox send $type"
      ;;
    *) die 'can only reply to messages in your own inbox';;
  esac

  req="$(frontmatter_value "$msg" requires_ack)"
  case "$req" in
    true) ;;
    false)
      # Low-ceremony close: a non-task letter may one-shot result|nack (no ACK).
      if [[ "$type" == "ack" ]]; then
        die "ack is only for requires_ack:true tasks; for this letter use: letterbox reply <id> result <slug>  or  letterbox file <id>"
      fi
      ;;
    *) die "message has invalid requires_ack '$req' (expected true or false)";;
  esac
  doorbell_to="$(frontmatter_value "$msg" from)"
  # Body before lock: a hanging stdin must not pin the letter.
  read_reply_body_or_die
  acquire_lifecycle_lock "$msg"
  trap 'release_lifecycle_lock' EXIT
  if [[ ! -f "$msg" ]]; then
    release_lifecycle_lock
    trap - EXIT
    printf 'already closed: %s\n' "$(confirm_label "$msg")"
    return 0
  fi
  local body="$REPLY_BODY" label reply_label
  publish_derived_reply "$msg" "$type" "$body" "$priority"
  if [[ "$type" == "ack" ]]; then
    create_ack_stamp "$msg" "$REPLY_FILE"
    label="$(confirm_label "$msg")"
    reply_label="$(confirm_label "$REPLY_FILE")"
    release_lifecycle_lock
    trap - EXIT
    [[ "$priority" == now && "$REPLY_ALREADY" == false ]] && ring_doorbell "$doorbell_to" "$type" "$slug" "$(frontmatter_value "$REPLY_FILE" id)"
    printf 'acked: %s (in progress; reply: %s)\n' "$label" "$reply_label"
    return 0
  fi
  # Capture labels BEFORE the move: a post-move confirm would see a missing
  # file and fall back to a filename-derived label.
  label="$(confirm_label "$msg")"
  reply_label="$(confirm_label "$REPLY_FILE")"
  mv "$msg" "$BOX/$ME/processed/"
  rm -f "$msg.ack"
  release_lifecycle_lock
  trap - EXIT
  [[ "$priority" == now && "$REPLY_ALREADY" == false ]] && ring_doorbell "$doorbell_to" "$type" "$slug" "$(frontmatter_value "$REPLY_FILE" id)"
  printf 'closed: %s → %s/processed/ (reply: %s)\n' "$label" "$ME" "$reply_label"
}


cmd_file() {
  need_me
  local msg_arg="${1:?usage: letterbox file <id|display-id|token|path> [--read]}" assert_read=false
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --read) assert_read=true;;
      *) die "unknown option: $1 (usage: letterbox file <id|display-id|token|path> [--read])";;
    esac
    shift
  done
  local msg typ label arg_is_path=false inbox_canon processed_canon
  message_arg_is_path "$msg_arg" && arg_is_path=true
  if [[ "$arg_is_path" == true ]]; then
    msg="$(resolve_owned_message "$msg_arg")" || die "message not found: $(safe_id_out "$msg_arg")"
  else
    msg="$(resolve_action_ref "$msg_arg" owned 0)" || die "message not found: $(safe_id_out "$msg_arg")"
  fi
  # Canonicalize for macOS /var vs /private/var
  msg="$(cd "$(dirname "$msg")" && pwd -P)/$(basename "$msg")"
  inbox_canon="$(canonical_dir "$(inbox_path "$ME")")"
  processed_canon="$(canonical_dir "$(processed_path "$ME")")"
  case "$msg" in
    "$inbox_canon"/*) ;;
    "$processed_canon"/*) printf 'already filed: %s\n' "$(confirm_label "$msg")"; return 0;;
    *) die 'can only file messages in your own inbox';;
  esac
  if [[ "$(frontmatter_value "$msg" requires_ack)" != "false" ]]; then
    die 'cannot file a task letter; use: letterbox reply <id> result|nack <slug>'
  fi
  typ="$(frontmatter_value "$msg" type)"
  case "$typ" in
    result|nack)
      # Structural rule C: an inbound terminal reply given as a filesystem path
      # requires --read (caller assertion, not a receipt). An explicit
      # id/display-id/token files directly.
      if [[ "$arg_is_path" == true && "$assert_read" != true ]]; then
        die "refusing to file unread inbound $typ from a path; re-run: letterbox file <path> --read"
      fi
      ;;
  esac
  # Capture the label BEFORE the move: a post-move confirm would see a missing
  # file and fall back to a filename-derived label.
  label="$(confirm_label "$msg")" # pre-move capture (post-move file is gone)
  mv "$msg" "$BOX/$ME/processed/"
  [[ -f "$msg.ack" ]] && mv "$msg.ack" "$BOX/$ME/processed/" 2>/dev/null || true
  printf 'filed: %s → %s/processed/\n' "$label" "$ME"
}


cmd_done() {
  need_me
  local message="${1:?usage: letterbox done <id-or-file> --reply <delivered-reply-file>}"; shift
  [[ "${1:-}" == --reply ]] || die 'use letterbox reply for normal replies, or pass --reply <delivered-reply-file>'
  local reply="${2:?missing reply file}"
  [[ -f "$reply" ]] || die "reply file not found: $(safe_id_out "$reply")"
  message="$(resolve_own_inbox_message "$message")"
  local id from expected_dir actual_dir
  id="$(frontmatter_value "$message" id)"; from="$(frontmatter_value "$message" from)"
  [[ -n "$id" && -n "$from" ]] || die 'invalid inbound frontmatter'
  expected_dir="$(canonical_dir "$(inbox_path "$from")")"
  actual_dir="$(canonical_dir "$(dirname "$reply")")"
  [[ "$actual_dir" == "$expected_dir" ]] || die 'reply must be delivered in the sender inbox before archiving'
  [[ "$(frontmatter_value "$reply" from)" == "$ME" ]] || die 'reply from does not match this agent'
  [[ "$(frontmatter_value "$reply" to)" == "$from" ]] || die 'reply to does not match original sender'
  [[ "$(frontmatter_value "$reply" re)" == "$id" ]] || die 'reply re does not match original message'
  [[ -f "$message.ack" ]] && die 'legacy done cannot close accepted work; use letterbox reply <id> result|nack'
  local label reply_label
  label="$(confirm_label "$message")"
  reply_label="$(confirm_label "$reply")"
  mv "$message" "$BOX/$ME/processed/"
  printf 'done: %s → %s/processed/ (reply: %s)\n' "$label" "$ME" "$reply_label"
}


lock_name() {
  local p
  p="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  p="${p//-/--}"
  p="${p//\//-slash-}"
  printf '%s.lock' "$p"
}
cmd_lock() {
  need_me
  local target="${1:?usage: letterbox lock <path>}" lock="$BOX/locks/$(lock_name "${1:?}")"
  mkdir -p "$BOX/locks"
  mkdir "$lock" 2>/dev/null || die "locked or being acquired: $lock"
  printf 'owner=%s%s taken=%s\n' "$ME" "${SESSION:+ session=$SESSION}" "$(now)" > "$lock/lease"
  printf 'locked: %s\n' "$lock"
}
cmd_unlock() {
  need_me
  local target="${1:?usage: letterbox unlock <path>}" lock="$BOX/locks/$(lock_name "${1:?}")"
  local lease="$lock/lease"
  [[ -d "$lock" ]] || { printf 'no lock: %s\n' "$lock"; return; }
  [[ -f "$lease" ]] || die "invalid lock without lease: $lock"
  local owner; owner="$(sed -n 's/.*owner=\([^ ]*\).*/\1/p' "$lease")"
  [[ "$owner" == "$ME" ]] || die "lock is owned by $owner"
  rm "$lease" && rmdir "$lock"
  printf 'unlocked: %s\n' "$lock"
}
cmd_status() {
  need_me
  local state="${1:?usage: letterbox status <working|idle|blocked>}" note="${2:-}"
  case "$state" in working|idle|blocked) ;; *) die 'invalid state';; esac
  mkdir -p "$BOX/$ME"
  printf 'state: %s\nsince: %s\nnotes: %s\n' "$state" "$(now)" "$note" > "$BOX/$ME/status.md"
}
case "${1:-}" in
  --version|-V|version) cmd_version;;
  init) shift; cmd_init "$@";; send) shift; cmd_send "$@";; check) shift; cmd_check "$@";;
  read) shift; cmd_read "$@";; progress) shift; cmd_progress "$@";; nudge) shift; cmd_nudge "$@";; token) shift; cmd_token "$@";;
  doorbell-line) shift; cmd_doorbell_line "$@";; doorbell-parse) shift; cmd_doorbell_parse "$@";;
  reply) shift; cmd_reply "$@";; file) shift; cmd_file "$@";; done) shift; cmd_done "$@";;
  lock) shift; cmd_lock "$@";; unlock) shift; cmd_unlock "$@";;
  status) shift; cmd_status "$@";; zellij) shift; cmd_zellij "$@";;
  *) printf 'usage: letterbox {init|send|check|read|progress|nudge|doorbell-line|doorbell-parse|token|reply|file|done|lock|unlock|status|zellij|--version} ...\n\nzellij: setup | run | register | unregister | status\n' >&2; exit 2;;
esac
